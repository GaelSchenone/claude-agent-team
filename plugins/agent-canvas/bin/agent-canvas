#!/usr/bin/env node
// agent-canvas start | stop | status — maneja el servidor local del canvas.
const http = require("http");
const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawn } = require("child_process");

const PORT = Number(process.env.AGENT_CANVAS_PORT || 7789);
const URL_ = `http://127.0.0.1:${PORT}`;
const PID_FILE = path.join(os.tmpdir(), `agent-canvas-${PORT}.pid`);
const SERVER = path.join(__dirname, "..", "canvas", "server.mjs");

const health = () => new Promise((resolve) => {
  const req = http.get(`${URL_}/api/health`, { timeout: 1200 }, (r) => { r.resume(); resolve(r.statusCode === 200); });
  req.on("error", () => resolve(false)); req.on("timeout", () => { req.destroy(); resolve(false); });
});
const wait = (ms) => new Promise((r) => setTimeout(r, ms));

(async () => {
  const cmd = process.argv[2] || "status";
  if (cmd === "start") {
    if (await health()) { console.log(`agent-canvas ya está corriendo: ${URL_}`); return; }
    spawn(process.execPath, [SERVER], { detached: true, stdio: "ignore", env: process.env }).unref();
    for (let i = 0; i < 20; i++) { await wait(200); if (await health()) { console.log(`agent-canvas listo: ${URL_}`); return; } }
    console.error(`agent-canvas no respondió en ${URL_}. ¿El puerto ${PORT} está ocupado por otro programa?`); process.exit(1);
  } else if (cmd === "stop") {
    try { process.kill(Number(fs.readFileSync(PID_FILE, "utf8"))); console.log("agent-canvas detenido"); }
    catch { console.log("agent-canvas no estaba corriendo"); }
  } else if (cmd === "status") {
    console.log((await health()) ? `agent-canvas corriendo: ${URL_}` : "agent-canvas detenido");
  } else {
    console.error("uso: agent-canvas start | stop | status"); process.exit(2);
  }
})();
